menu "MiniOS"

    config MINIOS_ENABLE_NETWORK
        bool "Enable Wi-Fi networking"
        depends on SOC_WIFI_SUPPORTED
        default y
        help
            Include Wi-Fi station mode, IPv4/DNS support, ICMP ping,
            the wifi/ifconfig/ping shell commands, and /dev/wifi0.
            Disable this option for projects that do not need networking
            to avoid linking the ESP-IDF Wi-Fi and network stacks.

endmenu
